{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fc-paejae-jeogeumso",
  "main": "src/server/index.ts",
  "compatibility_date": "2025-07-22",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "fc-paejae-jeogeumso",
    "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
